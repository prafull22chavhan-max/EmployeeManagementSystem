@model Project
@{
    ViewData["Title"] = "Edit Project";
    var employees = ViewBag.Employees as IEnumerable<Employee> ?? Enumerable.Empty<Employee>();
    var selected = ViewBag.SelectedEmployeeIds as IEnumerable<int> ?? Enumerable.Empty<int>();
}

<h1>Edit Project</h1>
<form asp-action="Edit" method="post" class="mt-3">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Assigned Employees</label>
        <div class="border rounded p-3">
            @if (!employees.Any())
            {
                <p class="mb-0 text-muted">No employees available yet.</p>
            }
            else
            {
                @foreach (var employee in employees)
                {
                    var checkedValue = selected.Contains(employee.Id) ? "checked" : null;
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="selectedEmployeeIds" value="@employee.Id"
                               checked="@checkedValue" />
                        <label class="form-check-label">@employee.FullName (@employee.Email)</label>
                    </div>
                }
            }
        </div>
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
